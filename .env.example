# Copy to .env.local and fill in. Never commit real values.

# Required. Signs session cookies. Generate with: npx auth secret
AUTH_SECRET=

# Required in production behind a proxy (Firebase App Hosting, Docker…).
# AUTH_TRUST_HOST=true

# Optional. Postgres connection string (Neon, Supabase, Cloud SQLâ€¦).
# Leave unset to use the embedded PGlite database in ./.data/pglite.
# DATABASE_URL=postgres://user:pass@host:5432/tastymaziwa

# Optional. Where the embedded PGlite database lives (default ./.data/pglite).
# PGLITE_DIR=./.data/pglite

# Optional. Bearer token for GET /api/cron/bill-subscriptions (daily scheduler).
# CRON_SECRET=

# Optional. Initial owner account for `npm run db:seed`.
# SEED_OWNER_USERNAME=owner
# SEED_OWNER_PASSWORD=

# Optional. Genkit / Gemini (AI features, not yet in use).
# GEMINI_API_KEY=
