# Copy to .env.local and fill in. Never commit real values.
# On Vercel, set these under Project Settings > Environment Variables.

# --- Required -----------------------------------------------------------------

# Signs session cookies and hashes one-time codes. Generate with: npx auth secret
AUTH_SECRET=

# Postgres connection string. REQUIRED on Vercel (use the pooled URL from Neon/Supabase).
# Leave unset locally to use the embedded PGlite database in ./.data/pglite.
# DATABASE_URL=postgres://user:pass@host:5432/tastymaziwa

# Optional: a direct (unpooled) connection used only for migrations on Production
# deploys. Neon's Vercel integration sets this automatically.
# DATABASE_URL_UNPOOLED=postgres://user:pass@host:5432/tastymaziwa

# --- Email (SMTP via Nodemailer) ------------------------------------------------
# Sign-up codes, sign-in codes, password resets and staff invites.
# Without SMTP_HOST, development writes emails to .data/outbox/ (and logs them);
# production refuses to start a send rather than silently drop it.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587                  # 465 = implicit TLS, 587 = STARTTLS
# SMTP_USER=you@example.com
# SMTP_PASS=app-password
# EMAIL_FROM="TastyMaziwa <you@example.com>"
# SMTP_SECURE=                   # optional override: true/false

# Base URL for links in emails. Never taken from the request (prevents reset-link poisoning).
# On Vercel it defaults to the project's production URL; set it if you use a custom domain.
# APP_URL=https://tastymaziwa.example.com

# --- Sessions -------------------------------------------------------------------
# SESSION_IDLE_SECONDS=1800      # sign out after 30 min without activity
# SESSION_MAX_SECONDS=43200      # and always after 12 h (one shift)
# SESSION_RECHECK_SECONDS=300    # how often a session re-checks the user is still active

# --- Optional -------------------------------------------------------------------

# Emails (codes, reset links) allowed per IP per 15 min (default 15). Raise it if many
# users share one network address.
# RATE_LIMIT_EMAILS_PER_IP=15

# Bearer token for GET /api/cron/bill-subscriptions. Set it in Vercel and Vercel Cron
# sends it automatically (see vercel.json). Generate: openssl rand -base64 32
# CRON_SECRET=

# Only needed on self-hosted servers behind a proxy (Docker, VPS). Vercel sets this automatically.
# AUTH_TRUST_HOST=true

# Where the embedded PGlite database lives (default ./.data/pglite).
# PGLITE_DIR=./.data/pglite

# `npm run db:seed`: the demo shop and its owner.
# SEED_OWNER_EMAIL=owner@example.com
# SEED_OWNER_PASSWORD=
# SEED_SHOP_NAME=Demo Dairy
# With --demo, the seller and supplier logins (sign in with an email code):
# SEED_SELLER_EMAIL=seller@example.com
# SEED_SUPPLIER_EMAIL=supplier@example.com

# --- "Try the demo" (button on /login and /signup) ---------------------------------
# Each visitor gets a private sample shop, deleted after 24 h by the daily cron.
# DEMO_DISABLED=1               # hide the button and refuse new demos
# RATE_LIMIT_DEMOS_PER_IP=5     # new demos per IP per hour
# DEMO_MAX_LIVE=300             # live demo shops at once, across everyone

# Testing: write emails to a folder even in a production build.
# EMAIL_TRANSPORT=file
# EMAIL_OUTBOX_DIR=.data/outbox

# --- M-Pesa (Lipa na M-Pesa STK Push) ------------------------------------------------
# Each shop enters its own Daraja keys in the app (Finance -> M-Pesa); they are
# stored encrypted with this key. Optional: without it, a key is derived from
# AUTH_SECRET (then rotating AUTH_SECRET means owners re-enter their M-Pesa keys).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# MPESA_CREDENTIALS_KEY=
# Safaricom must reach /api/mpesa/callback/... over public HTTPS: set APP_URL to
# your public URL (in development, a tunnel such as ngrok or cloudflared).

# --- WhatsApp stock updates (WhatsApp Business Cloud API, Meta) ----------------------
# Owners set their number in Settings -> WhatsApp stock updates. Without a token,
# development writes messages to .data/outbox/whatsapp-*.json (and logs them);
# production skips them with a warning.
# Messages the shop starts must use an approved template. Create one in WhatsApp
# Manager (category Utility) with two body variables, e.g.:
#   "Stock update for {{1}}: {{2}} Sent by TastyMaziwa."
# WHATSAPP_ACCESS_TOKEN=          # a System User token with whatsapp_business_messaging
# WHATSAPP_PHONE_NUMBER_ID=       # the sending number's ID (not the phone number itself)
# WHATSAPP_STOCK_TEMPLATE=stock_update
# WHATSAPP_TEMPLATE_LANG=en       # must match the template's language exactly (en, en_US…)
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_TRANSPORT=file         # testing: write to the outbox even in a production build
