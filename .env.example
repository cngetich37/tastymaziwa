# Copy to .env.local and fill in. Never commit real values.
# On Vercel, set these under Project Settings > Environment Variables.

# --- Required -----------------------------------------------------------------

# Signs session cookies and hashes one-time codes. Generate with: npx auth secret
AUTH_SECRET=

# Postgres connection string. REQUIRED on Vercel (use the pooled URL from Neon/Supabase).
# Leave unset locally to use the embedded PGlite database in ./.data/pglite.
# DATABASE_URL=postgres://user:pass@host:5432/tastymaziwa

# --- Email (SMTP via Nodemailer) ------------------------------------------------
# Sign-up codes, sign-in codes, password resets and staff invites.
# Without SMTP_HOST, development writes emails to .data/outbox/ (and logs them);
# production refuses to start a send rather than silently drop it.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587                  # 465 = implicit TLS, 587 = STARTTLS
# SMTP_USER=you@example.com
# SMTP_PASS=app-password
# EMAIL_FROM="TastyMaziwa <you@example.com>"
# SMTP_SECURE=                   # optional override: true/false

# Base URL for links in emails. Never taken from the request (prevents reset-link poisoning).
# On Vercel it defaults to the project's production URL; set it if you use a custom domain.
# APP_URL=https://tastymaziwa.example.com

# --- Sessions -------------------------------------------------------------------
# SESSION_IDLE_SECONDS=1800      # sign out after 30 min without activity
# SESSION_MAX_SECONDS=43200      # and always after 12 h (one shift)
# SESSION_RECHECK_SECONDS=300    # how often a session re-checks the user is still active

# --- Optional -------------------------------------------------------------------

# Bearer token for GET /api/cron/bill-subscriptions. Set it in Vercel and Vercel Cron
# sends it automatically (see vercel.json). Generate: openssl rand -base64 32
# CRON_SECRET=

# Only needed on self-hosted servers behind a proxy (Docker, VPS). Vercel sets this automatically.
# AUTH_TRUST_HOST=true

# Where the embedded PGlite database lives (default ./.data/pglite).
# PGLITE_DIR=./.data/pglite

# `npm run db:seed`: the demo shop and its owner.
# SEED_OWNER_EMAIL=owner@example.com
# SEED_OWNER_PASSWORD=
# SEED_SHOP_NAME=Demo Dairy

# Testing: write emails to a folder even in a production build.
# EMAIL_TRANSPORT=file
# EMAIL_OUTBOX_DIR=.data/outbox
