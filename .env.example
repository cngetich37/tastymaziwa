# Copy to .env.local and fill in. Never commit real values.
# On Vercel, set these under Project Settings > Environment Variables.

# Required. Signs session cookies. Generate with: npx auth secret
AUTH_SECRET=

# Postgres connection string. REQUIRED on Vercel (use the pooled URL from Neon/Supabase).
# Leave unset locally to use the embedded PGlite database in ./.data/pglite.
# DATABASE_URL=postgres://user:pass@host:5432/tastymaziwa

# Optional. Where the embedded PGlite database lives (default ./.data/pglite).
# PGLITE_DIR=./.data/pglite

# Bearer token for GET /api/cron/bill-subscriptions. Set it in Vercel and Vercel Cron
# sends it automatically (see vercel.json). Generate: openssl rand -base64 32
# CRON_SECRET=

# Only needed on self-hosted servers behind a proxy (Docker, VPS). Vercel sets this automatically.
# AUTH_TRUST_HOST=true

# Optional. Initial owner account for `npm run db:seed`.
# SEED_OWNER_USERNAME=owner
# SEED_OWNER_PASSWORD=

# Optional. Genkit / Gemini (AI features, not yet in use).
# GEMINI_API_KEY=
