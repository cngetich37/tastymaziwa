          "value": "\"ledger_entries\".\"kind\" <> 'customer_payment' or (\"ledger_entries\".\"customer_id\" is not null and \"ledger_entries\".\"payment_method\" in ('cash', 'mpesa'))"
        },
        "ledger_supplier_entries_have_supplier": {
          "name": "ledger_supplier_entries_have_supplier",
